/* SBC2 Design System: High-Performance Desktop Production */

QWidget {
    background-color: @surface_dim;
    color: @on_surface;
    font-family: @font_family_body;
    font-size: @font_size_px;
    selection-background-color: @selection;
    selection-color: @on_surface;
    outline: none;
}

QMainWindow,
QDialog {
    background-color: @surface_dim;
}

QToolTip {
    color: @on_surface;
    background-color: @surface_container_highest;
    border: 1px solid @outline_ghost;
    border-radius: @rounded_sm;
    padding: @spacing_2 @spacing_3;
}

/* No-line sectioning via chroma separation and tonal layering */
QFrame[panel="true"],
QWidget[panel="true"] {
    background-color: @surface_container;
    border: none;
    border-radius: @rounded_md;
    padding: @spacing_4;
}

QFrame[panelAlt="true"],
QWidget[panelAlt="true"] {
    background-color: @surface_container_high;
    border: none;
    border-radius: @rounded_md;
    padding: @spacing_4;
}

/* Left Sidebar Menu */
QFrame#Sidebar {
    background-color: @surface_container_low;
    border: none;
}

QWidget#SidebarHeader {
    background: transparent;
}

QLabel#SidebarBrandCrest {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @primary,
        stop: 1 @secondary
    );
    color: @on_primary_fixed;
    border-radius: 14px;
    font-family: @font_family_display;
    font-size: 11px;
    font-weight: 700;
}

QLabel#SidebarBrandTitle {
    color: @on_surface;
    background: transparent;
    font-family: @font_family_display;
    font-size: 15px;
    font-weight: 650;
}

QLabel#SidebarBrandSubtitle {
    color: @on_surface_variant;
    background: transparent;
    font-size: 10px;
    letter-spacing: 0.8px;
}

QPushButton[sidebarNav="true"] {
    background-color: transparent;
    color: @on_surface_variant;
    border: none;
    border-radius: 0px;
    padding: @spacing_4 14px @spacing_4 14px;
    text-align: left;
    font-weight: 550;
}

QPushButton[sidebarToggle="true"] {
    background-color: transparent;
    color: @on_surface_variant;
    border: none;
    border-radius: @rounded_md;
    padding: @spacing_2;
    min-width: 34px;
}

QPushButton[sidebarToggle="true"]:hover {
    background-color: @surface_container_high;
    color: @on_surface;
}

QFrame#Sidebar[collapsed="true"] QPushButton[sidebarNav="true"] {
    text-align: center;
    padding: @spacing_4 @spacing_2;
}

QFrame#Sidebar[collapsed="true"] QPushButton[sidebarNav="true"]:checked,
QFrame#Sidebar[collapsed="true"] QPushButton[sidebarNav="true"][active="true"] {
    border-left: none;
    border-radius: @rounded_md;
    padding-left: @spacing_2;
}

QPushButton[sidebarNav="true"]:hover {
    background-color: @surface_container_high;
    color: @on_surface;
}

QPushButton[sidebarNav="true"]:checked,
QPushButton[sidebarNav="true"][active="true"] {
    color: @on_surface;
    font-weight: 600;
    border-left: 2px solid @primary;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 @primary_alpha_15,
        stop: 0.6 @primary_alpha_05,
        stop: 1.0 transparent
    );
    padding-left: 12px;
}

QPushButton[sidebarNav="true"]:checked:hover,
QPushButton[sidebarNav="true"][active="true"]:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 @primary_alpha_25,
        stop: 1.0 transparent
    );
}

QWidget#SidebarProfile {
    background-color: @surface_container_high;
    border-radius: @rounded_md;
}

QLabel#SidebarProfileAvatar {
    background-color: @secondary_container;
    color: @on_secondary_container;
    border-radius: 14px;
    font-family: @font_family_mono;
    font-size: 10px;
    font-weight: 650;
}

QLabel#SidebarProfileName {
    background: transparent;
    color: @on_surface;
    font-size: 12px;
    font-weight: 600;
}

QLabel#SidebarProfileRole {
    background: transparent;
    color: @on_surface_variant;
    font-size: 10px;
}

QLabel[workspaceTitle="true"] {
    color: @on_surface_variant;
    letter-spacing: 0.7px;
    font-size: 11px;
    font-weight: 620;
}

QLabel#WorkspaceHeader,
QLabel#WorkspaceFooter {
    background-color: @surface_container;
}

/* Floating overlays (glass-like layer; blur should be handled in code when available). */
QFrame[floating="true"],
QWidget[floating="true"] {
    background-color: rgba(35, 38, 42, 217);
    border: 1px solid @outline_ghost;
    border-radius: @rounded_md;
}

QLabel[title="true"] {
    color: @on_surface;
    font-family: @font_family_display;
    font-size: 20px;
    font-weight: 620;
}

QLabel[displayMd="true"] {
    color: @on_surface;
    font-family: @font_family_display;
    font-size: 44px;
    font-weight: 640;
}

QLabel[section="true"] {
    color: @on_surface_variant;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QLabel[muted="true"] {
    color: @on_surface_variant;
}

QLabel[technical="true"] {
    color: @on_surface_variant;
    font-family: @font_family_mono;
    font-size: 11px;
}

QLabel[typeBadge="true"] {
    background-color: @type_text;
    color: @type_badge_text;
    border: 1px solid @outline_20;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel[typeBadge="true"][blockType="container"] {
    background-color: @type_container;
}

QLabel[typeBadge="true"][blockType="empty"] {
    background-color: @type_empty;
}

QLabel[typeBadge="true"][blockType="image"] {
    background-color: @type_image;
}

QLabel[typeBadge="true"][blockType="video"] {
    background-color: @type_video;
}

QLabel[typeBadge="true"][blockType="audio"] {
    background-color: @type_audio;
}

QLabel[typeBadge="true"][blockType="text"] {
    background-color: @type_text;
}

QLabel[typeBadge="true"][blockType="prompt"] {
    background-color: @type_prompt;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: @surface_container_highest;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    padding: @spacing_3 @spacing_4;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border: 1px solid @primary;
}

/* Dropdown buttons (ComboBox): primary pill look */
QComboBox {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary,
        stop: 1 @primary
    );
    color: @on_primary_fixed;
    border: none;
    border-radius: @rounded_full;
    padding: @spacing_3 30px @spacing_3 @spacing_5;
    font-weight: 620;
}

QComboBox:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary,
        stop: 1 @primary_hover
    );
}

QComboBox:pressed {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary_dim,
        stop: 1 @primary_dim
    );
}

QComboBox:disabled {
    background: @surface_variant;
    color: @on_surface_variant;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid @primary_alpha_25;
    background: transparent;
    border-top-right-radius: @rounded_full;
    border-bottom-right-radius: @rounded_full;
}

QComboBox QAbstractItemView {
    background-color: @surface_container_high;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    selection-background-color: @primary;
    selection-color: @on_primary_fixed;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: @spacing_2 @spacing_3;
}

QComboBox QAbstractItemView::item:hover {
    background-color: @primary_alpha_15;
}

QLineEdit[searchBar="true"],
QLineEdit[commandBar="true"] {
    background-color: @surface_container_highest;
    border: 1px solid @outline_ghost;
    border-radius: @rounded_full;
    padding: @spacing_4 @spacing_6;
}

/* Buttons */
QPushButton,
QToolButton {
    background-color: transparent;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    padding: @spacing_3 @spacing_5;
}

QPushButton:hover,
QToolButton:hover {
    background-color: @surface_container_highest;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: @surface_container_high;
}

/* Primary / Hero action: signature gradient. */
QPushButton[accent="true"],
QToolButton[accent="true"],
QPushButton[primary="true"],
QToolButton[primary="true"] {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @primary,
        stop: 1 @secondary
    );
    color: @on_primary_fixed;
    border: none;
    border-radius: @rounded_md;
    font-weight: 620;
    padding: @spacing_4 @spacing_6;
}

QPushButton[accent="true"]:hover,
QToolButton[accent="true"]:hover,
QPushButton[primary="true"]:hover,
QToolButton[primary="true"]:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @primary_hover,
        stop: 1 @secondary
    );
}

QPushButton[accent="true"]:pressed,
QToolButton[accent="true"]:pressed,
QPushButton[primary="true"]:pressed,
QToolButton[primary="true"]:pressed {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @primary_dim,
        stop: 1 @secondary_dim
    );
}

/* Secondary ghost action */
QPushButton[ghost="true"],
QToolButton[ghost="true"] {
    background-color: transparent;
    border: 1px solid @outline_20;
    color: @on_surface;
}

QPushButton[ghost="true"]:hover,
QToolButton[ghost="true"]:hover {
    background-color: @surface_container_highest;
}

/* AI/Magic action */
QPushButton[aiMagic="true"],
QToolButton[aiMagic="true"] {
    background-color: @surface_container_high;
    color: @on_surface;
    border: 2px solid @tertiary_container;
    border-radius: @rounded_md;
    padding: @spacing_4 @spacing_6;
}

/* Settings tabs */
QTabWidget#SettingsTabs::pane {
    border: none;
    border-top: 1px solid @outline_20;
    background: transparent;
}

QTabWidget#SettingsTabs QTabBar::tab {
    background-color: @surface_container_highest;
    color: @on_surface_variant;
    border: none;
    border-top-left-radius: @rounded_md;
    border-top-right-radius: @rounded_md;
    padding: @spacing_3 @spacing_5;
    margin-right: @spacing_2;
}

QTabWidget#SettingsTabs QTabBar::tab:hover:!selected {
    background-color: @surface_container_high;
    color: @on_surface;
}

QTabWidget#SettingsTabs QTabBar::tab:selected {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary,
        stop: 1 @primary
    );
    color: @on_primary_fixed;
    border: none;
    font-weight: 620;
}

/* Content containers */
QListView,
QListWidget,
QTreeView,
QTreeWidget {
    background-color: @surface_container_low;
    color: @on_surface;
    border: none;
    alternate-background-color: @surface_container;
}

QListView::item,
QListWidget::item,
QTreeView::item,
QTreeWidget::item {
    padding: @spacing_2;
}

QListView::item:hover,
QListWidget::item:hover,
QTreeView::item:hover,
QTreeWidget::item:hover {
    background-color: @surface_container_high;
}

QListView::item:selected,
QListWidget::item:selected,
QTreeView::item:selected,
QTreeWidget::item:selected {
    background-color: @selection;
    color: @on_surface;
}

/* Production scrollbar primitives (no-line, tonal layering, subtle hover intent). */
QScrollBar[productionScrollBar="true"],
QScrollBar[productionScrollBar=true] {
    background: transparent;
    border: none;
}

QScrollBar[productionScrollBar="true"]:vertical,
QScrollBar[productionScrollBar=true]:vertical {
    background-color: @surface_container_low;
    width: 12px;
    margin: 0;
}

QScrollBar[productionScrollBar="true"]:horizontal,
QScrollBar[productionScrollBar=true]:horizontal {
    background-color: @surface_container_low;
    height: 12px;
    margin: 0;
}

QScrollBar[productionScrollBar="true"]::handle:vertical,
QScrollBar[productionScrollBar=true]::handle:vertical {
    background-color: @primary;
    min-height: 26px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar[productionScrollBar="true"]::handle:horizontal,
QScrollBar[productionScrollBar=true]::handle:horizontal {
    background-color: @primary;
    min-width: 26px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar[productionScrollBar="true"]::add-line,
QScrollBar[productionScrollBar=true]::add-line,
QScrollBar[productionScrollBar="true"]::sub-line,
QScrollBar[productionScrollBar=true]::sub-line,
QScrollBar[productionScrollBar="true"]::up-arrow,
QScrollBar[productionScrollBar=true]::up-arrow,
QScrollBar[productionScrollBar="true"]::down-arrow,
QScrollBar[productionScrollBar=true]::down-arrow,
QScrollBar[productionScrollBar="true"]::left-arrow,
QScrollBar[productionScrollBar=true]::left-arrow,
QScrollBar[productionScrollBar="true"]::right-arrow,
QScrollBar[productionScrollBar=true]::right-arrow {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar[productionScrollBar="true"]::add-page,
QScrollBar[productionScrollBar=true]::add-page,
QScrollBar[productionScrollBar="true"]::sub-page,
QScrollBar[productionScrollBar=true]::sub-page {
    background: transparent;
}

/* Media cards: no divider line, separation by spacing + tonal shift. */
QWidget[thumbnailCard="true"] {
    background-color: @surface_container_high;
    border: none;
    border-radius: 10px;
    padding: @spacing_2;
}

QWidget[thumbnailCard="true"]:hover {
    background-color: @surface_container_highest;
}

QFrame[carouselItem="true"],
QWidget[carouselItem="true"] {
    background-color: @surface_container_high;
    border: none;
    border-radius: 10px;
    padding: 0px;
}

QFrame[carouselItem="true"][selected="true"],
QWidget[carouselItem="true"][selected="true"] {
    background-color: @surface_container_highest;
}

/* Production-specific patterns */
QWidget[timelineTrack="true"],
QFrame[timelineTrack="true"] {
    background-color: @surface_container_lowest;
    border: none;
    border-radius: @rounded_sm;
}

QLabel[sceneChip="true"] {
    background-color: @secondary_container;
    color: @on_secondary_container;
    border: none;
    border-radius: @rounded_sm;
    padding: @spacing_1 @spacing_2;
    font-family: @font_family_mono;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar[aiProgress="true"] {
    background-color: @surface_variant;
    color: @on_surface_variant;
    border: none;
    border-radius: @rounded_sm;
    text-align: center;
}

QProgressBar[aiProgress="true"]::chunk {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 @tertiary,
        stop: 1 @primary
    );
    border-radius: @rounded_sm;
}
