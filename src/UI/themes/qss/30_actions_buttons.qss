/* Buttons */
QPushButton,
QToolButton {
    background-color: transparent;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    padding: @spacing_3 @spacing_5;
}

QPushButton:hover,
QToolButton:hover {
    background-color: @surface_container_highest;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: @surface_container_high;
}

/* Primary / Hero action: signature gradient. */
QPushButton[accent="true"],
QToolButton[accent="true"],
QPushButton[primary="true"],
QToolButton[primary="true"] {
    background-color: @primary;
    color: @on_primary_fixed;
    border: none;
    border-radius: @rounded_md;
    font-weight: 620;
    padding: @spacing_4 @spacing_6;
}

QPushButton[accent="true"]:hover,
QToolButton[accent="true"]:hover,
QPushButton[primary="true"]:hover,
QToolButton[primary="true"]:hover {
    background-color: @primary_hover;
}

QPushButton[accent="true"]:pressed,
QToolButton[accent="true"]:pressed,
QPushButton[primary="true"]:pressed,
QToolButton[primary="true"]:pressed {
    background-color: @primary_dim;
}

/* Secondary ghost action */
QPushButton[ghost="true"],
QToolButton[ghost="true"] {
    background-color: transparent;
    border: 1px solid @outline_20;
    color: @on_surface;
}

QPushButton[ghost="true"]:hover,
QToolButton[ghost="true"]:hover {
    background-color: @surface_container_highest;
}

/* AI/Magic action */
QPushButton[aiMagic="true"],
QToolButton[aiMagic="true"] {
    background-color: @surface_container_high;
    color: @on_surface;
    border: 1px solid @tertiary_container;
    border-radius: @rounded_md;
    padding: @spacing_4 @spacing_6;
}

/* Settings tabs */
QTabWidget#SettingsTabs::pane {
    border: none;
    border-top: 1px solid @outline_20;
    background: transparent;
}

QTabWidget#SettingsTabs QTabBar::tab {
    background-color: @surface_container_highest;
    color: @on_surface_variant;
    border: none;
    border-top-left-radius: @rounded_md;
    border-top-right-radius: @rounded_md;
    padding: @spacing_3 @spacing_5;
    margin-right: @spacing_2;
}

QTabWidget#SettingsTabs QTabBar::tab:hover:!selected {
    background-color: @surface_container_high;
    color: @on_surface;
}

QTabWidget#SettingsTabs QTabBar::tab:selected {
    background-color: @surface_container;
    color: @on_surface;
    border-bottom: 2px solid @primary;
    font-weight: 620;
}

/* ─── Disabled states ────────────────────────────────────────────────────────*/

QPushButton:disabled,
QToolButton:disabled {
    color: @on_surface_muted;
    border-color: @outline_ghost;
    background-color: transparent;
}

QPushButton[accent="true"]:disabled,
QToolButton[accent="true"]:disabled,
QPushButton[primary="true"]:disabled,
QToolButton[primary="true"]:disabled {
    background-color: @surface_variant;
    color: @on_surface_muted;
    border: none;
}

/* ─── Checked / toggled state ────────────────────────────────────────────────
   Used for toggle buttons and mode switches (e.g. view mode selectors). */

QPushButton:checked,
QToolButton:checked {
    background-color: @primary_alpha_15;
    color: @on_surface;
    border-color: @primary_alpha_25;
}

QPushButton:checked:hover,
QToolButton:checked:hover {
    background-color: @primary_alpha_25;
}

QPushButton:checked:disabled,
QToolButton:checked:disabled {
    background-color: @surface_container;
    color: @on_surface_muted;
    border-color: @outline_ghost;
}

/* ─── Danger / destructive action ────────────────────────────────────────────
   Ghost style by default; fills on hover. Use property danger="true". */

QPushButton[danger="true"],
QToolButton[danger="true"] {
    background-color: transparent;
    color: @danger;
    border: 1px solid @danger_alpha_15;
    border-radius: @rounded_md;
    padding: @spacing_3 @spacing_5;
}

QPushButton[danger="true"]:hover,
QToolButton[danger="true"]:hover {
    background-color: @danger_alpha_15;
    border-color: @danger_alpha_25;
}

QPushButton[danger="true"]:pressed,
QToolButton[danger="true"]:pressed {
    background-color: @danger_alpha_25;
}

QPushButton[danger="true"]:disabled,
QToolButton[danger="true"]:disabled {
    color: @on_surface_muted;
    border-color: @outline_ghost;
    background-color: transparent;
}

/* ─── AI / Magic action hover ────────────────────────────────────────────────*/

QPushButton[aiMagic="true"]:hover,
QToolButton[aiMagic="true"]:hover {
    background-color: @surface_container_highest;
    border-color: @tertiary;
}

/* ─── Icon-only compact button ───────────────────────────────────────────────
   Small square button for toolbar / panel action icon buttons. */

QPushButton[iconOnly="true"],
QToolButton[iconOnly="true"] {
    padding: @spacing_3;
    min-width: 30px;
    min-height: 30px;
    border-radius: @rounded_md;
}
