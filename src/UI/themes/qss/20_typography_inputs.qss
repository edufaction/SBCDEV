/* Floating overlays (glass-like layer; blur should be handled in code when available). */
QFrame[floating="true"],
QWidget[floating="true"] {
    background-color: rgba(35, 38, 42, 217);
    border: 1px solid @outline_ghost;
    border-radius: @rounded_md;
}

QLabel[title="true"],
QLabel[title=true] {
    color: @on_surface;
    font-family: @font_family_display;
    font-size: 20px;
    font-weight: 620;
}

QLabel[displayMd="true"],
QLabel[displayMd=true] {
    color: @on_surface;
    font-family: @font_family_display;
    font-size: 44px;
    font-weight: 640;
}

QLabel[section="true"],
QLabel[section=true] {
    color: @on_surface_variant;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QLabel[muted="true"],
QLabel[muted=true] {
    color: @on_surface_variant;
}

QLabel[technical="true"],
QLabel[technical=true] {
    color: @on_surface_variant;
    font-family: @font_family_mono;
    font-size: 11px;
}

QLabel[typeBadge="true"],
QLabel[typeBadge=true] {
    background-color: @type_text;
    color: @type_badge_text;
    border: 1px solid @outline_20;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel[typeBadge="true"][blockType="container"],
QLabel[typeBadge=true][blockType="container"] {
    background-color: @type_container;
}

QLabel[typeBadge="true"][blockType="empty"],
QLabel[typeBadge=true][blockType="empty"] {
    background-color: @type_empty;
}

QLabel[typeBadge="true"][blockType="image"],
QLabel[typeBadge=true][blockType="image"] {
    background-color: @type_image;
}

QLabel[typeBadge="true"][blockType="video"],
QLabel[typeBadge=true][blockType="video"] {
    background-color: @type_video;
}

QLabel[typeBadge="true"][blockType="audio"],
QLabel[typeBadge=true][blockType="audio"] {
    background-color: @type_audio;
}

QLabel[typeBadge="true"][blockType="text"],
QLabel[typeBadge=true][blockType="text"] {
    background-color: @type_text;
}

QLabel[typeBadge="true"][blockType="prompt"],
QLabel[typeBadge=true][blockType="prompt"] {
    background-color: @type_prompt;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: @surface_container_highest;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    padding: @spacing_3 @spacing_4;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border: 1px solid @primary;
}

/* Dropdown buttons (ComboBox): primary pill look */
QComboBox {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary,
        stop: 1 @primary
    );
    color: @on_primary_fixed;
    border: none;
    border-radius: @rounded_full;
    padding: @spacing_3 30px @spacing_3 @spacing_5;
    font-weight: 620;
}

QComboBox:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary,
        stop: 1 @primary_hover
    );
}

QComboBox:pressed {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 @secondary_dim,
        stop: 1 @primary_dim
    );
}

QComboBox:disabled {
    background: @surface_variant;
    color: @on_surface_variant;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid @primary_alpha_25;
    background: transparent;
    border-top-right-radius: @rounded_full;
    border-bottom-right-radius: @rounded_full;
}

QComboBox QAbstractItemView {
    background-color: @surface_container_high;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    selection-background-color: @primary;
    selection-color: @on_primary_fixed;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: @spacing_2 @spacing_3;
}

QComboBox QAbstractItemView::item:hover {
    background-color: @primary_alpha_15;
}

QLineEdit[searchBar="true"],
QLineEdit[searchBar=true],
QLineEdit[commandBar="true"],
QLineEdit[commandBar=true] {
    background-color: @surface_container_highest;
    border: 1px solid @outline_ghost;
    border-radius: @rounded_full;
    padding: @spacing_4 @spacing_6;
}
