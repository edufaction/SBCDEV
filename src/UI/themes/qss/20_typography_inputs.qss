/* Floating overlays (glass-like layer; blur should be handled in code when available). */
QFrame[floating="true"],
QWidget[floating="true"] {
    background-color: @surface_container_highest;
    border: 1px solid @outline_ghost;
    border-radius: @rounded_md;
}

QLabel[title="true"] {
    color: @on_surface;
    font-family: @font_family_display;
    font-size: 18px;
    font-weight: 620;
}

QLabel[displayMd="true"] {
    color: @on_surface;
    font-family: @font_family_display;
    font-size: 38px;
    font-weight: 640;
}

QLabel[section="true"] {
    color: @on_surface_variant;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QLabel[muted="true"] {
    color: @on_surface_variant;
}

QLabel[technical="true"] {
    color: @on_surface_variant;
    font-family: @font_family_mono;
    font-size: 11px;
}

QLabel[typeBadge="true"] {
    background-color: @type_text;
    color: @type_badge_text;
    border: 1px solid @outline_20;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

QLabel[typeBadge="true"][blockType="container"] {
    background-color: @type_container;
}

QLabel[typeBadge="true"][blockType="empty"] {
    background-color: @type_empty;
}

QLabel[typeBadge="true"][blockType="image"] {
    background-color: @type_image;
}

QLabel[typeBadge="true"][blockType="video"] {
    background-color: @type_video;
}

QLabel[typeBadge="true"][blockType="audio"] {
    background-color: @type_audio;
}

QLabel[typeBadge="true"][blockType="text"] {
    background-color: @type_text;
}

QLabel[typeBadge="true"][blockType="prompt"] {
    background-color: @type_prompt;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: @surface_container_highest;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    padding: @spacing_3 @spacing_4;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border: 1px solid @primary;
}

/* Dropdown buttons (ComboBox): primary pill look */
QComboBox {
    background-color: @surface_container_highest;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    padding: @spacing_3 30px @spacing_3 @spacing_4;
    font-weight: 500;
}

QComboBox:hover {
    background-color: @surface_container_high;
    border: 1px solid @outline;
}

QComboBox:pressed {
    background-color: @surface_container;
}

QComboBox:disabled {
    background: @surface_variant;
    color: @on_surface_variant;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid @outline_20;
    background: transparent;
    border-top-right-radius: @rounded_md;
    border-bottom-right-radius: @rounded_md;
}

QComboBox QAbstractItemView {
    background-color: @surface_container_high;
    color: @on_surface;
    border: 1px solid @outline_20;
    border-radius: @rounded_md;
    selection-background-color: @primary;
    selection-color: @on_primary_fixed;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: @spacing_2 @spacing_3;
}

QComboBox QAbstractItemView::item:hover {
    background-color: @primary_alpha_15;
}

QLineEdit[searchBar="true"],
QLineEdit[commandBar="true"] {
    background-color: @surface_container_highest;
    border: 1px solid @outline_ghost;
    border-radius: @rounded_full;
    padding: @spacing_4 @spacing_6;
}

/* ─── Disabled input states ──────────────────────────────────────────────────*/

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: @on_surface_muted;
    border-color: @outline_ghost;
    background-color: @surface_container;
}

/* ─── SpinBox arrow buttons ──────────────────────────────────────────────────*/

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    border-left: 1px solid @outline_20;
    border-top-right-radius: @rounded_md;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    border-left: 1px solid @outline_20;
    border-bottom-right-radius: @rounded_md;
    background: transparent;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: @surface_container_high;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: @surface_container_highest;
}

/* ─── Enhanced focus ring ────────────────────────────────────────────────────
   Slightly elevated background on focus to reinforce active field. */

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: @surface_container_high;
}
